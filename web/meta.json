{
  "title": "Income Prediction",
  "subtitle": "Predicts whether a person earns more than $50K a year from census information such as age, education, occupation and hours worked.",
  "tags": [
    "Classification",
    "Pipelines",
    "Cross-validation",
    "XGBoost",
    "SHAP",
    "ONNX"
  ],
  "task": "classification",
  "classes": [
    0,
    1
  ],
  "positive_class": 1,
  "output_label": "Probability of earning more than $50K / year",
  "verdicts": [
    "Likely \u2264 $50K",
    "Uncertain",
    "Likely > $50K"
  ],
  "thresholds": [
    0.35,
    0.65
  ],
  "positive_is_good": true,
  "result_note": "Try changing Education, Occupation or Hours worked per week. Census data from 1994 \u2014 dollar amounts are not inflation-adjusted.",
